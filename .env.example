# Copy to .env (never commit .env).

# --- Secrets ---
AHREFS_API_TOKEN=
# Google Sheet that holds the content queue (the ID from its URL)
BLOG_SHEET_ID=
# Service account JSON with edit access to that Sheet
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
# Optional: discovery report email
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_NOTIFY=

# --- Configuration ---
# Your own domain, used by the competitor gap scan
SITE_DOMAIN=acmesupply.example
COMPANY_NAME=Acme Supply Co.
# SHEET_TAB_COMMERCIAL=Commercial
# SHEET_TAB_INFORMATIONAL=Informational
# SHEET_TAB_WHOLESALE=Wholesale
# CONFIG_DIR=./config
